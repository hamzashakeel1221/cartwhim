{
  "name": "cartwhim",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "start": "next start",
    "lint": "eslint",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "deploy": "npm run build && npm run cf-deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply cartwhim --local",
    "db:migrate:remote": "wrangler d1 migrations apply cartwhim --remote",
    "cf-build": "npm run build",
    "cf-deploy": "opennextjs-cloudflare deploy && wrangler d1 migrations apply cartwhim --remote",
    "build:next": "next build"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.18",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "lucide-react": "^1.79.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "three": "^0.170.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.170.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.168.0"
  }
}
