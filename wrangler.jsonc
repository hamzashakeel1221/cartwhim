{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cartwhim",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Self-reference service binding required by OpenNext, must match "name" above.
    { "binding": "WORKER_SELF_REFERENCE", "service": "cartwhim" }
  ],
  "images": {
    // Cloudflare Images binding for next/image optimization
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cartwhim",
      // Replace with the id printed by: npx wrangler d1 create cartwhim
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
