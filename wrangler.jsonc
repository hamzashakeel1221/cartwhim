{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cartwhim",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Self-reference service binding required by OpenNext, must match "name" above.
    { "binding": "WORKER_SELF_REFERENCE", "service": "cartwhim" }
  ],
  "images": {
    // Cloudflare Images binding for next/image optimization
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      // No database_id on purpose: the first `wrangler deploy` creates the "cartwhim" D1 database automatically
      // and remembers it for later deploys.
      "binding": "DB",
      "database_name": "cartwhim",
      "migrations_dir": "migrations"
    }
  ],
  // Branch previews (wrangler preview, used by Workers Builds for pull requests) need their own bindings block.
  "previews": {
    "images": { "binding": "IMAGES" }
  },
  "observability": { "enabled": true },
  // Keep variables and secrets set in the Cloudflare dashboard (ADMIN_PASSWORD) on every deploy.
  "keep_vars": true
}
